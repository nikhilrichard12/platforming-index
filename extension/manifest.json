{
  "manifest_version": 3,
  "name": "Platforming Index",
  "version": "0.1.0",
  "description": "Shows the part Voltara already buys at the moment someone requests a new one.",
  "minimum_chrome_version": "102",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/mock-procurement*"],
      "js": ["adapters.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["http://localhost:3000/*"],
  "action": {
    "default_title": "Platforming Index",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
