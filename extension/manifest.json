{
  "manifest_version": 3,
  "name": "PlatInform",
  "version": "0.2.0",
  "description": "Checks the page you are reading against the parts your company already buys.",
  "minimum_chrome_version": "114",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "storage", "tabs"],
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "https://*.atlassian.net/*",
        "https://airtable.com/*",
        "https://kearney-perlab.growthsignals.com/*"
      ],
      "js": ["adapters.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.atlassian.net/*",
    "https://airtable.com/*",
    "https://kearney-perlab.growthsignals.com/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "PlatInform",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
