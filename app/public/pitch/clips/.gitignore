# The camera-original recordings stay out of the repository: plugin.mov is
# 51 MB, and the deck plays the transcoded plugin.mp4 beside it. Keep the
# original wherever it was filmed; regenerate the mp4 with
#
#   ffmpeg -i plugin.mov -an -c:v libx264 -crf 23 -pix_fmt yuv420p \
#     -vf "scale='min(1920,iw)':'min(1080,ih)':force_original_aspect_ratio=decrease:force_divisible_by=2" \
#     -movflags +faststart plugin.mp4
*.mov
